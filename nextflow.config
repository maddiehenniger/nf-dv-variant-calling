manifest {
    author            = 'Madison T. Henniger; Trevor F. Freeman'
    defaultBranch     = 'main'
    recurseSubmodules = false
    description       = 'A Nextflow pipeline for variant calling.'
    mainScript        = 'main.nf'
    name              = 'maddiehenniger/nf-imputation-pipeline'
    nextflowVersion   = '!>=23.10.0'
    version           = 'v0.0.0.1'
}

timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm')

params {
    /*
    ---------------------------------------------------------------------
        Input/Output Options
    ---------------------------------------------------------------------
    */
    // REQUIRED INPUT: Project Title
    // User-defined project title for each Nextflow run
    projectTitle    = null

    // REQUIRED INPUT: Test Sample Metadata
    // User-provided samplesheet metadata - see README for requirements
    samplesheet     = null

    // REQUIRED INPUT: Reference Genome
    // A path to the reference genome FASTA file 
    reference       = null

    // REQUIRED INPUT: Adapter Sequences
    // A path to a Trimmomatic-formatted file to remove adapter sequences from input samplesheet
    adapters        = null

    // Publish Options
    publishDirData    = "${launchDir}/data"
    publishDirReports = "${launchDir}/reports"
    publishMode       = 'copy'
}

/*
---------------------------------------------------------------------
    Import Configuration Files
---------------------------------------------------------------------
*/
includeConfig 'conf/args.config'
includeConfig 'conf/containers.config'
includeConfig 'conf/plugins.config'
includeConfig 'conf/reporting.config'
includeConfig 'conf/resources.config'

includeConfig 'conf/isaac.config'
profiles {
    exploratory {
        params {
            publishDirData    = "${launchDir}/exploratory/${timestamp}_${params.projectTitle}/data"
            publishDirReports = "${launchDir}/exploratory/${timestamp}_${params.projectTitle}/reports"
            publishMode       = 'symlink'
        }
        resume = true
    }

}