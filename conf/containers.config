process {
    withLabel: 'fastqc' {
        container = 'https://depot.galaxyproject.org/singularity/fastqc%3A0.12.1--hdfd78af_0'
    }
    withLabel: 'multiqc' {
        container = 'https://depot.galaxyproject.org/singularity/multiqc%3A1.33--pyhdfd78af_0'
    }
    withLabel: 'seqkit' {
        container = 'https://depot.galaxyproject.org/singularity/seqkit%3A2.12.0--he881be0_1'
    }
    withLabel: 'trimmomatic' {
        container = 'https://depot.galaxyproject.org/singularity/trimmomatic%3A0.40--hdfd78af_0'
    }
    withLabel: 'bwa' {
        container = 'https://depot.galaxyproject.org/singularity/bwa-mem2%3A2.3--he70b90d_0'
    }
    withLabel: 'picard' {
        container = 'https://depot.galaxyproject.org/singularity/picard%3A3.4.0--hdfd78af_0'
    }
}

singularity {
    enabled = true
}